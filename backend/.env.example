# ==============================================================================
# Metro Motors — Production Environment Configuration (.env.example)
# NEVER commit your actual .env file or credentials to Git.
# Copy this file to .env and replace placeholders with your actual secrets.
# ==============================================================================

# ── MongoDB Atlas Database Configuration ──
# Get this connection string from MongoDB Atlas: Database -> Connect -> Connect your application
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<DB_USER>:<DB_PASSWORD>@<YOUR_CLUSTER>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="motors"

# Legacy fallback support
MONGO_URL="mongodb://localhost:27017"
DB_NAME="metro_motors"
DISABLE_REMOTE_DB="0"

# ── Application Environment & Access Control ──
# Set to "production" in live deployment to strictly enforce JWT length and disable demo logins
ENV="development"
OWNER_EMAILS="alex@metromotors.in,owner@metromotors.in"
WORKER_EMAILS="staff@metromotors.in"

# ── Application & JWT Security ──
# Generate a strong 64-character random secret: openssl rand -hex 32
JWT_SECRET_KEY="<LONG_RANDOM_SECRET_FOR_JWT_SIGNING>"
OTP_HMAC_SECRET="<LONG_RANDOM_SECRET_FOR_OTP_HMAC_HASHING>"
SESSION_SECRET="<LONG_RANDOM_SECRET_FOR_SESSIONS>"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# ── Google OAuth 2.0 Credentials ──
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="<YOUR_GOOGLE_OAUTH_CLIENT_ID>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<YOUR_GOOGLE_OAUTH_CLIENT_SECRET>"

# ── Base Application URLs & CORS ──
APP_BASE_URL="http://localhost:3001"
BACKEND_BASE_URL="http://127.0.0.1:8001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# ── SMTP Email Service (Password Recovery OTP & Welcome Notifications) ──
# Supported providers: Gmail App Password, Brevo / Sendinblue, SendGrid, Amazon SES
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="<YOUR_SMTP_USERNAME_OR_EMAIL>"
SMTP_PASS="<YOUR_SMTP_PASSWORD_OR_APP_PASSWORD>"
EMAIL_FROM="noreply@metromotors.in"
EMAIL_FROM_NAME="Metro Motors Bangalore"
